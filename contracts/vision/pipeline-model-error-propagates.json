{
  "name": "pipeline-model-error-propagates",
  "setup": {
    "kind": "pipeline",
    "image": {
      "width": 1,
      "height": 1,
      "data": [
        7,
        8,
        9
      ]
    },
    "spec": {
      "input": {
        "width": 1,
        "height": 1,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "nearest",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    },
    "task": "classify",
    "scripted": {
      "error": "model failed"
    },
    "clock": [
      0,
      1,
      2,
      3
    ]
  },
  "expect": {
    "modelError": "model failed",
    "modelCalls": 1,
    "clockReads": 2
  }
}
