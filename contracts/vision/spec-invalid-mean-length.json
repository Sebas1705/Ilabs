{
  "name": "spec-invalid-mean-length",
  "setup": {
    "kind": "spec",
    "spec": {
      "input": {
        "width": 224,
        "height": 224,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "bilinear",
        "dtype": "float",
        "mean": [
          0,
          0
        ]
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "error": {
      "kind": "invalid_spec",
      "message": "invalid model spec: input.mean must be an array of 3 finite numbers"
    }
  }
