{
  "name": "spec-invalid-null-coordinates",
  "setup": {
    "kind": "spec",
    "spec": {
      "input": {
        "width": 224,
        "height": 224,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "bilinear",
        "dtype": "float"
      },
      "output": {
        "format": "ssd",
        "coordinates": null
      }
    }
  },
  "expect": {
    "error": {
      "kind": "invalid_spec",
      "message": "invalid model spec: output.coordinates must be \"normalized\" or \"pixels\""
    }
  }
}
