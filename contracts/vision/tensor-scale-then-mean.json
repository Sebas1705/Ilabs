{
  "name": "tensor-scale-then-mean",
  "setup": {
    "kind": "tensor",
    "image": {
      "width": 2,
      "height": 1,
      "data": [
        100,
        200,
        50,
        0,
        40,
        255
      ]
    },
    "spec": {
      "input": {
        "width": 2,
        "height": 1,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "nearest",
        "dtype": "float",
        "scale": 0.5,
        "mean": [
          10,
          20,
          30
        ],
        "std": [
          2,
          8,
          5
        ]
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "shape": [
      1,
      1,
      2,
      3
    ],
    "data": [
      20,
      10,
      -1,
      -5,
      0,
      19.5
    ]
  }
}
