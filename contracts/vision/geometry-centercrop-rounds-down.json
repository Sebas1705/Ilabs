{
  "name": "geometry-centercrop-rounds-down",
  "setup": {
    "kind": "geometry",
    "srcWidth": 10,
    "srcHeight": 3,
    "spec": {
      "input": {
        "width": 4,
        "height": 4,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "centerCrop",
        "resample": "nearest",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "geometry": {
      "scaleX": 1.3,
      "scaleY": 1.3333333333333333,
      "offsetX": -4,
      "offsetY": 0,
      "newWidth": 13,
      "newHeight": 4
    }
  }
}
