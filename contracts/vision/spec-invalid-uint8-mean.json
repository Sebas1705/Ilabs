{
  "name": "spec-invalid-uint8-mean",
  "setup": {
    "kind": "spec",
    "spec": {
      "input": {
        "width": 224,
        "height": 224,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "bilinear",
        "dtype": "uint8",
        "mean": [
          0,
          0,
          0
        ]
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "error": {
      "kind": "invalid_spec",
      "message": "invalid model spec: input.mean is not allowed with dtype uint8"
    }
  }
}
