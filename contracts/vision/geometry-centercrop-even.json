{
  "name": "geometry-centercrop-even",
  "setup": {
    "kind": "geometry",
    "srcWidth": 400,
    "srcHeight": 200,
    "spec": {
      "input": {
        "width": 100,
        "height": 100,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "centerCrop",
        "resample": "nearest",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "geometry": {
      "scaleX": 0.5,
      "scaleY": 0.5,
      "offsetX": -50,
      "offsetY": 0,
      "newWidth": 200,
      "newHeight": 100
    }
  }
}
