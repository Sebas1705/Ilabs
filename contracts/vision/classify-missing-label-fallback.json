{
  "name": "classify-missing-label-fallback",
  "setup": {
    "kind": "classify",
    "output": [
      0.4,
      0.3,
      0.2,
      0.1
    ],
    "spec": {
      "input": {
        "width": 2,
        "height": 2,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "nearest",
        "dtype": "float"
      },
      "output": {
        "type": "probabilities"
      },
      "labels": [
        "a",
        "b"
      ]
    }
  },
  "expect": {
    "entries": [
      {
        "index": 0,
        "label": "a",
        "score": 0.4
      },
      {
        "index": 1,
        "label": "b",
        "score": 0.3
      },
      {
        "index": 2,
        "label": "#2",
        "score": 0.2
      },
      {
        "index": 3,
        "label": "#3",
        "score": 0.1
      }
    ]
  }
}
