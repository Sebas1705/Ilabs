{
  "name": "spec-invalid-layout",
  "setup": {
    "kind": "spec",
    "spec": {
      "input": {
        "width": 224,
        "height": 224,
        "layout": "chw",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "bilinear",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "error": {
      "kind": "invalid_spec",
      "message": "invalid model spec: input.layout must be \"nhwc\" or \"nchw\""
    }
  }
}
