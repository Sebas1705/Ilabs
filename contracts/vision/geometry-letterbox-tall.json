{
  "name": "geometry-letterbox-tall",
  "setup": {
    "kind": "geometry",
    "srcWidth": 360,
    "srcHeight": 640,
    "spec": {
      "input": {
        "width": 320,
        "height": 320,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "letterbox",
        "resample": "nearest",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "geometry": {
      "scaleX": 0.5,
      "scaleY": 0.5,
      "offsetX": 70,
      "offsetY": 0,
      "newWidth": 180,
      "newHeight": 320
    }
  }
}
