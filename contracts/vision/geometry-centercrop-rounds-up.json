{
  "name": "geometry-centercrop-rounds-up",
  "setup": {
    "kind": "geometry",
    "srcWidth": 6,
    "srcHeight": 4,
    "spec": {
      "input": {
        "width": 5,
        "height": 5,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "centerCrop",
        "resample": "nearest",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "geometry": {
      "scaleX": 1.3333333333333333,
      "scaleY": 1.25,
      "offsetX": -1,
      "offsetY": 0,
      "newWidth": 8,
      "newHeight": 5
    }
  }
}
