{
  "name": "spec-invalid-mode",
  "setup": {
    "kind": "spec",
    "spec": {
      "input": {
        "width": 224,
        "height": 224,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "centercrop",
        "resample": "bilinear",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    }
  },
  "expect": {
    "error": {
      "kind": "invalid_spec",
      "message": "invalid model spec: input.mode must be \"stretch\", \"centerCrop\" or \"letterbox\""
    }
  }
}
