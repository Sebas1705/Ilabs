{
  "name": "spec-invalid-boxorder-value",
  "setup": {
    "kind": "spec",
    "spec": {
      "input": {
        "width": 224,
        "height": 224,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "stretch",
        "resample": "bilinear",
        "dtype": "float"
      },
      "output": {
        "format": "ssd",
        "boxOrder": "xywh"
      }
    }
  },
  "expect": {
    "error": {
      "kind": "invalid_spec",
      "message": "invalid model spec: output.boxOrder must be \"yxyx\" or \"xyxy\""
    }
  }
}
