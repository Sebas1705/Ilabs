{
  "name": "unmap-letterbox",
  "setup": {
    "kind": "geometry",
    "srcWidth": 640,
    "srcHeight": 360,
    "spec": {
      "input": {
        "width": 320,
        "height": 320,
        "layout": "nhwc",
        "channels": "rgb",
        "mode": "letterbox",
        "resample": "nearest",
        "dtype": "float"
      },
      "output": {
        "type": "logits"
      }
    },
    "boxes": [
      {
        "x1": 32,
        "y1": 100,
        "x2": 160,
        "y2": 170
      },
      {
        "x1": 0,
        "y1": 70,
        "x2": 320,
        "y2": 250
      }
    ]
  },
  "expect": {
    "geometry": {
      "scaleX": 0.5,
      "scaleY": 0.5,
      "offsetX": 0,
      "offsetY": 70,
      "newWidth": 320,
      "newHeight": 180
    },
    "unmapped": [
      {
        "x1": 64,
        "y1": 60,
        "x2": 320,
        "y2": 200
      },
      {
        "x1": 0,
        "y1": 0,
        "x2": 640,
        "y2": 360
      }
    ]
  }
}
