{
  "name": "chunk-fixed-text-shorter-than-overlap",
  "setup": {
    "kind": "chunk",
    "documents": [
      {
        "id": "d",
        "text": "ab"
      }
    ],
    "chunking": {
      "type": "fixed",
      "size": 4,
      "overlap": 2
    }
  },
  "expect": {
    "chunks": [
      {
        "id": "d#0",
        "docId": "d",
        "index": 0,
        "text": "ab",
        "start": 0,
        "end": 2
      }
    ]
  }
}
