{
  "kind": "limiter",
  "name": "limiter-window-edge-999-denied-1000-allowed",
  "limit": 1,
  "windowMs": 1000,
  "calls": [
    {
      "key": "a",
      "now": 0
    },
    {
      "key": "a",
      "now": 999
    },
    {
      "key": "a",
      "now": 1000
    }
  ],
  "expect": [
