{
  "kind": "handler",
  "name": "handler-map-system-last-and-interleaved",
  "env": {
    "GEMINI_API_KEY": "FIXTURE_SERVER_KEY",
    "GEMINI_MODEL": "fixture-model-1",
    "ALLOWED_ORIGINS": "https://app.example.test,http://localhost:5173"
  },
  "request": {
    "method": "POST",
    "path": "/v1/complete",
    "headers": {
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7"
    },
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "a"
        },
        {
          "role": "system",
          "content": "S1"
        },
        {
          "role": "assistant",
          "content": "b"
        },
        {
          "role": "system",
          "content": "S2"
        }
      ]
    }
  },
  "upstream": [
    {
      "status": 200,
      "body": {
        "candidates": [
          {
            "content": {
              "role": "model",
              "parts": [
                {
                  "text": "Hi there"
                }
              ]
            },
            "finishReason": "STOP"
          }
        ],
        "usageMetadata": {
          "promptTokenCount": 3,
          "candidatesTokenCount": 2,
          "totalTokenCount": 5
        }
      }
    }
  ],
  "expect": {
    "status": 200,
    "body": {
      "text": "Hi there",
      "provider": "gateway"
    },
    "upstreamCalls": 1,
    "upstream": {
      "model": "fixture-model-1",
      "key": "FIXTURE_SERVER_KEY",
      "maxOutputTokens": 256,
      "contentsCount": 2,
      "systemInstruction": "S1\n\nS2",
      "contents": [
        {
          "role": "user",
          "text": "a"
        },
        {
          "role": "model",
          "text": "b"
        }
      ]
    }
  }
}
