{
  "kind": "handler",
  "name": "handler-upstream-429-retry-delay-float-trap",
  "env": {
    "GEMINI_API_KEY": "FIXTURE_SERVER_KEY",
    "GEMINI_MODEL": "fixture-model-1",
    "ALLOWED_ORIGINS": "https://app.example.test,http://localhost:5173"
  },
  "request": {
    "method": "POST",
    "path": "/v1/complete",
    "headers": {
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7"
    },
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "upstream": [
    {
      "status": 429,
      "body": {
        "error": {
          "code": 429,
          "message": "quota text FIXTURE_UPSTREAM_TEXT",
          "status": "RESOURCE_EXHAUSTED",
          "details": [
            {
              "@type": "type.googleapis.com/google.rpc.RetryInfo",
              "retryDelay": "2.007s"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "status": 429,
    "body": {
      "error": {
        "kind": "rate_limit",
        "retryAfterMs": 2007
      }
    },
    "headers": {
      "retry-after": "3"
    },
    "upstreamCalls": 1,
    "upstream": {
      "model": "fixture-model-1",
      "key": "FIXTURE_SERVER_KEY",
      "maxOutputTokens": 256,
      "contentsCount": 1
    }
  }
}
