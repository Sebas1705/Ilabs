{
  "kind": "client",
  "name": "client-retry-after-dropped-for-other-kinds",
  "endpoint": "https://gateway.example.test",
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "hello"
      }
    ]
  },
  "transport": [
    {
      "status": 504,
      "body": {
        "error": {
          "kind": "timeout",
          "retryAfterMs": 500
        }
      }
    }
  ],
  "expect": {
    "result": {
      "error": {
        "kind": "timeout"
      }
    },
    "requests": [
      {
        "url": "https://gateway.example.test/v1/complete",
        "method": "POST",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "hello"
            }
          ]
        },
        "timeoutMs": 25000
      }
    ]
  }
}
