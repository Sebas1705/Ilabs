{
  "kind": "handler",
  "name": "handler-rate-retry-after-999ms",
  "env": {
    "GEMINI_API_KEY": "FIXTURE_SERVER_KEY",
    "GEMINI_MODEL": "fixture-model-1",
    "ALLOWED_ORIGINS": "https://app.example.test,http://localhost:5173"
  },
  "request": {
    "method": "POST",
    "path": "/v1/complete",
    "headers": {
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7"
    },
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "limiterPreload": 10,
  "limiterPreloadAgeMs": 59001,
  "upstream": [],
  "expect": {
    "status": 429,
    "body": {
      "error": {
        "kind": "rate_limit",
        "retryAfterMs": 999
      }
    },
    "upstreamCalls": 0,
    "headers": {
      "retry-after": "1"
    }
  }
}
