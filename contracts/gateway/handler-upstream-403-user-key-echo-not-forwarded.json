{
  "kind": "handler",
  "name": "handler-upstream-403-user-key-echo-not-forwarded",
  "env": {
    "GEMINI_API_KEY": "FIXTURE_SERVER_KEY",
    "GEMINI_MODEL": "fixture-model-1",
    "ALLOWED_ORIGINS": "https://app.example.test,http://localhost:5173"
  },
  "request": {
    "method": "POST",
    "path": "/v1/complete",
    "headers": {
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7",
      "x-ilabs-api-key": "FIXTURE_USER_KEY"
    },
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "upstream": [
    {
      "status": 403,
      "body": {
        "error": {
          "message": "key FIXTURE_USER_KEY is not allowed"
        }
      },
      "headers": {
        "x-echo": "FIXTURE_USER_KEY"
      }
    }
  ],
  "expect": {
    "status": 503,
    "body": {
      "error": {
        "kind": "unavailable"
      }
    },
    "upstreamCalls": 1,
    "upstream": {
      "model": "fixture-model-1",
      "key": "FIXTURE_USER_KEY",
      "maxOutputTokens": 256,
      "contentsCount": 1
    }
  }
}
