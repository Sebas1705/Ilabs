{
  "kind": "handler",
  "name": "handler-preflight-without-origin",
  "env": {
    "GEMINI_API_KEY": "FIXTURE_SERVER_KEY",
    "GEMINI_MODEL": "fixture-model-1",
    "ALLOWED_ORIGINS": "https://app.example.test,http://localhost:5173"
  },
  "request": {
    "method": "OPTIONS",
    "path": "/v1/complete",
    "headers": {
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7"
    },
    "body": null
  },
  "upstream": [],
  "expect": {
    "status": 204,
    "headers": {
      "access-control-allow-methods": "POST, OPTIONS",
      "access-control-allow-headers": "content-type, x-ilabs-api-key",
      "access-control-max-age": "600",
      "vary": "Origin",
      "access-control-allow-origin": null
    },
    "upstreamCalls": 0
  }
}
