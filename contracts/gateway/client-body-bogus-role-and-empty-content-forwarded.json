{
  "kind": "client",
  "name": "client-body-bogus-role-and-empty-content-forwarded",
  "endpoint": "https://gateway.example.test",
  "request": {
    "messages": [
      {
        "role": "bogus",
        "content": ""
      }
    ],
    "maxTokens": 0
