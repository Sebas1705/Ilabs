{
  "kind": "handler",
  "name": "handler-rate-before-key",
  "env": {
    "GEMINI_MODEL": "fixture-model-1",
    "ALLOWED_ORIGINS": "https://app.example.test"
  },
  "request": {
    "method": "POST",
    "path": "/v1/complete",
    "headers": {
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7"
    },
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "limiterPreload": 10,
  "upstream": [],
  "expect": {
    "status": 429,
    "body": {
      "error": {
        "kind": "rate_limit",
        "retryAfterMs": 60000
      }
    },
    "upstreamCalls": 0
  }
}
