{
  "kind": "handler",
  "name": "handler-rate-earlier-valid-request-counts",
  "env": {
    "GEMINI_API_KEY": "FIXTURE_SERVER_KEY",
    "GEMINI_MODEL": "fixture-model-1",
    "ALLOWED_ORIGINS": "https://app.example.test,http://localhost:5173"
  },
  "request": {
    "method": "POST",
    "path": "/v1/complete",
    "headers": {
      "content-type": "application/json",
      "cf-connecting-ip": "203.0.113.7"
    },
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "before": [
    {
      "method": "POST",
      "path": "/v1/complete",
      "headers": {
        "content-type": "application/json",
        "cf-connecting-ip": "203.0.113.7"
      },
      "body": {
        "messages": [
          {
            "role": "user",
            "content": "hello"
          }
        ]
      }
    }
  ],
  "limiterPreload": 9,
  "upstream": [
    {
      "status": 200,
      "body": {
        "candidates": [
          {
            "content": {
              "role": "model",
              "parts": [
                {
                  "text": "first"
                }
              ]
            },
            "finishReason": "STOP"
          }
        ],
        "usageMetadata": {
          "promptTokenCount": 3,
          "candidatesTokenCount": 2,
          "totalTokenCount": 5
        }
      }
    }
  ],
  "expect": {
    "status": 429,
    "body": {
      "error": {
        "kind": "rate_limit",
        "retryAfterMs": 60000
      }
    },
    "upstreamCalls": 1,
    "upstream": {
      "model": "fixture-model-1",
      "key": "FIXTURE_SERVER_KEY",
      "maxOutputTokens": 256,
      "contentsCount": 1
    }
  }
}
