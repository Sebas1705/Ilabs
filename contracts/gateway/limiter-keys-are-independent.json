{
  "kind": "limiter",
  "name": "limiter-keys-are-independent",
  "limit": 1,
  "windowMs": 1000,
  "calls": [
    {
      "key": "a",
      "now": 0
    },
    {
      "key": "b",
      "now": 0
    },
    {
      "key": "a",
      "now": 1
    },
    {
      "key": "b",
      "now": 1
    }
  ],
  "expect": [
    {
      "allowed": true
    },
    {
      "allowed": true
    },
    {
      "allowed": false,
      "retryAfterMs": 999
    },
    {
      "allowed": false,
      "retryAfterMs": 999
    }
  ]
}
