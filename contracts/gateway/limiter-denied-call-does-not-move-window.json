{
  "kind": "limiter",
  "name": "limiter-denied-call-does-not-move-window",
  "limit": 1,
  "windowMs": 1000,
  "calls": [
    {
      "key": "a",
      "now": 0
    },
    {
      "key": "a",
      "now": 500
    },
    {
      "key": "a",
      "now": 1000
    }
  ],
  "expect": [
    {
      "allowed": true
    },
    {
      "allowed": false,
      "retryAfterMs": 500
    },
    {
      "allowed": true
    }
  ]
}
